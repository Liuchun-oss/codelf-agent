{
  "name": "codelf",
  "version": "0.2.1",
  "description": "Codelf（码灵）- 轻量级 Agent 辅助编程 IDE",
  "main": "./out/main/index.js",
  "author": "巫枫",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "electron-vite preview",
    "sync-brand": "node scripts/sync-brand.mjs",
    "build": "npm run sync-brand && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\"",
    "gen-icon": "node scripts/gen-icon.mjs",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "package": "npm run sync-brand && npm run rebuild:native && electron-vite build && electron-builder --win --dir",
    "dist": "npm run sync-brand && npm run rebuild:native && electron-vite build && electron-builder --win",
    "release": "npm run sync-brand && npm run rebuild:native && electron-vite build && electron-builder --win --publish always",
    "dist:mac": "npm run sync-brand && npm run rebuild:native && electron-vite build && electron-builder --mac",
    "package:mac": "npm run sync-brand && npm run rebuild:native && electron-vite build && electron-builder --mac --dir"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.100.1",
    "@huggingface/transformers": "^4.2.0",
    "@iconify-json/vscode-icons": "^1.2.53",
    "@iconify/react": "^6.0.2",
    "@lenml/tokenizers": "^3.7.2",
    "@lydell/node-pty": "^1.2.0-beta.12",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.6.0",
    "@shikijs/monaco": "^4.1.0",
    "@types/d3-force": "^3.0.10",
    "@vue/language-server": "^3.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "basedpyright": "^1.39.6",
    "better-sqlite3": "^12.11.1",
    "croner": "^9.1.0",
    "d3-force": "^3.0.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9",
    "ignore": "^7.0.5",
    "katex": "^0.17.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.15.0",
    "monaco-editor": "^0.52.2",
    "openai": "^6.41.0",
    "pdfjs-dist": "^6.0.227",
    "playwright": "^1.60.0",
    "qrcode": "^1.5.4",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.1.0",
    "silk-wasm": "^3.7.1",
    "sqlite-vec": "^0.1.9",
    "tiktoken": "^1.0.22",
    "typescript": "^5.7.2",
    "typescript-language-server": "^5.3.0",
    "undici": "^6.26.0",
    "vscode-langservers-extracted": "^4.10.0",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5",
    "yaml-language-server": "^1.23.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.6.1",
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "png-to-ico": "^3.0.1",
    "prettier": "^3.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.4.11"
  }
}
